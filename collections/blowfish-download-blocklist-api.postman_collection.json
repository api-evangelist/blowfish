              "mode": "raw",
              "raw": "{\n  \"priorityAllowLists\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"priorityBlockLists\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
